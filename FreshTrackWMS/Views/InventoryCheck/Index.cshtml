@model IEnumerable<FreshTrackWMS.Data.PhieuKiemKe>
@{
    ViewData["Title"] = "Kiểm kê kho";
}

<style>
    .table-detail th {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #555;
    }

    .table-detail td {
        vertical-align: middle;
    }

    .table-detail .form-control, .table-detail .form-select {
        border-radius: 4px;
        padding: 0.375rem 0.5rem;
        font-size: 0.9rem;
    }

    .diff-negative {
        color: #dc3545;
        font-weight: bold;
    }

    .diff-positive {
        color: #198754;
        font-weight: bold;
    }

    .diff-zero {
        color: #6c757d;
    }
</style>

<div class="content-padding">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="mb-0 text-info"><i class="fas fa-clipboard-check me-2"></i>Lịch sử Kiểm kê</h4>
        <button class="btn btn-info text-white fw-medium" data-bs-toggle="modal" data-bs-target="#inventoryCheckModal">
            <i class="fas fa-tasks me-2"></i>Tạo phiếu kiểm kê
        </button>
    </div>

    <div class="card p-3 border-0 shadow-sm mb-4">
        <form method="get" asp-action="Index" asp-controller="InventoryCheck">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Tìm mã phiếu kiểm kê...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter me-2"></i>Lọc</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card p-0 border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Ngày kiểm kê</th>
                        <th>Người kiểm kê</th>
                        <th class="text-center">Số mặt hàng kiểm</th>
                        <th class="text-center">Kết quả</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Không có phiếu kiểm kê nào.</td></tr>
                    }
                    @foreach (var ticket in Model)
                    {
                        var matHangKiem = ticket.ChiTietKiemKes.Count;
                        var lechSoLuong = ticket.ChiTietKiemKes.Count(c => c.TonHeThong != c.ThucTeDem);

                        <tr>
                            <td class="fw-medium text-info">PKK-@ticket.NgayKiemKe.ToString("yyMMdd")-@ticket.MaPhieuKiemKe.ToString("D2")</td>
                            <td>@ticket.NgayKiemKe.ToString("dd/MM/yyyy")</td>
                            <td>@(ticket.NguoiTaoNavigation?.TenTaiKhoan ?? "Thủ kho")</td>
                            <td class="text-center">@matHangKiem</td>
                            <td class="text-center">
                                @if (lechSoLuong > 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Lệch @lechSoLuong mã</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Khớp 100%</span>
                                }
                            </td>
                            <td class="text-center"><button class="btn btn-sm btn-light text-primary"><i class="fas fa-eye"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="inventoryCheckModal" tabindex="-1" aria-labelledby="inventoryCheckModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-info">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold" id="inventoryCheckModalLabel"><i class="fas fa-clipboard-list me-2"></i>Lập Phiếu Kiểm Kê Tồn Kho</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Create" asp-controller="InventoryCheck" method="post" id="formInventoryCheck">
                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Mã phiếu kiểm kê</label>
                            <input type="text" class="form-control bg-light" value="PKK-TỰ-ĐỘNG" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Ngày thực hiện <span class="text-danger">*</span></label>
                            <input type="date" name="NgayKiemKe" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-medium">Người kiểm kê</label>
                            <input type="text" class="form-control bg-light" value="Tự động lấy theo tài khoản" readonly>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h6 class="text-info mb-0"><i class="fas fa-list-ul me-2"></i>Chi tiết đối chiếu số liệu</h6>
                        <button type="button" class="btn btn-sm btn-outline-info" id="btnAddRow"><i class="fas fa-plus me-1"></i> Thêm mặt hàng</button>
                    </div>

                    <div class="table-responsive" style="min-height: 250px;">
                        <table class="table table-bordered table-detail" id="detailsTable">
                            <thead class="table-light text-center">
                                <tr>
                                    <th style="width: 35%;">Lô hàng - Thực phẩm</th>
                                    <th style="width: 12%;">Hệ thống</th>
                                    <th style="width: 15%;">Thực tế đếm</th>
                                    <th style="width: 10%;">Chênh lệch</th>
                                    <th style="width: 23%;">Lý do (nếu lệch)</th>
                                    <th style="width: 5%;"><i class="fas fa-cog"></i></th>
                                </tr>
                            </thead>
                            <tbody id="detailsBody">
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-info text-white fw-bold"><i class="fas fa-paper-plane me-2"></i>Lưu Phiếu Kiểm Kê</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Dữ liệu Lô hàng bắn từ Controller xuống
    const lotList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Lots));
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const detailsBody = document.getElementById('detailsBody');
        const btnAddRow = document.getElementById('btnAddRow');

        function createRowHtml() {
            let optionsHtml = '<option value="" selected disabled data-sys="0">-- Chọn Lô hàng kiểm kê --</option>';
            lotList.forEach(lot => {
                optionsHtml += `<option value="${lot.MaLo}" data-sys="${lot.TonKho}">Lô ${String(lot.MaLo).padStart(3, '0')} - ${lot.TenThucPham}</option>`;
            });

            const tr = document.createElement('tr');
            tr.innerHTML = `
                    <td>
                        <select class="form-select border-info lot-select" required>
                            ${optionsHtml}
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control bg-light text-end sys-qty-input" value="0" readonly>
                    </td>
                    <td>
                        <input type="number" class="form-control text-end real-qty-input" value="0" min="0" required>
                    </td>
                    <td class="text-center align-middle">
                        <span class="diff-result fw-bold diff-zero">0</span>
                    </td>
                    <td>
                        <input type="text" class="form-control reason-input" placeholder="Lý do...">
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="fas fa-trash"></i></button>
                    </td>
                `;
            return tr;
        }

        function updateRowIndexes() {
            const rows = detailsBody.querySelectorAll('tr');
            rows.forEach((row, index) => {
                row.querySelector('.lot-select').name = `Details[${index}].MaLo`;
                row.querySelector('.sys-qty-input').name = `Details[${index}].TonHeThong`;
                row.querySelector('.real-qty-input').name = `Details[${index}].ThucTeDem`;
                row.querySelector('.reason-input').name = `Details[${index}].LyDoDieuChinh`;
            });
        }

        // Auto tính số chênh lệch
        function calculateDiff(row) {
            const sysQty = parseInt(row.querySelector('.sys-qty-input').value) || 0;
            const realQty = parseInt(row.querySelector('.real-qty-input').value) || 0;
            const diffSpan = row.querySelector('.diff-result');

            const diff = realQty - sysQty;

            if (diff > 0) {
                diffSpan.textContent = "+" + diff;
                diffSpan.className = "diff-result diff-positive";
            } else if (diff < 0) {
                diffSpan.textContent = diff;
                diffSpan.className = "diff-result diff-negative";
            } else {
                diffSpan.textContent = "0";
                diffSpan.className = "diff-result diff-zero";
            }
        }

        btnAddRow.addEventListener('click', function () {
            detailsBody.appendChild(createRowHtml());
            updateRowIndexes();
        });

        // Lắng nghe sự kiện đổi Lô hàng (Lấy Tồn hệ thống) và Gõ số Thực tế đếm
        detailsBody.addEventListener('input', function (e) {
            const row = e.target.closest('tr');

            if (e.target.classList.contains('lot-select')) {
                // Lấy attribute data-sys chứa tồn kho đổ vào input readonly
                const selectedOption = e.target.options[e.target.selectedIndex];
                row.querySelector('.sys-qty-input').value = selectedOption.getAttribute('data-sys');
                calculateDiff(row);
            }

            if (e.target.classList.contains('real-qty-input')) {
                calculateDiff(row);
            }
        });

        detailsBody.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove')) {
                e.target.closest('tr').remove();
                updateRowIndexes();
            }
        });

        // Khởi tạo dòng đầu tiên
        detailsBody.appendChild(createRowHtml());
        updateRowIndexes();

        document.getElementById('formInventoryCheck').addEventListener('submit', function (e) {
            if (detailsBody.querySelectorAll('tr').length === 0) {
                e.preventDefault();
                alert('Mày phải thêm ít nhất 1 mặt hàng để kiểm kê!');
            }
        });
    });
</script>