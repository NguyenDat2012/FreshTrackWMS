@model IEnumerable<FreshTrackWMS.Data.PhieuNhap>
@{
    ViewData["Title"] = "Quản lý Nhập kho";
}

<style>
    .table-detail th {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #555;
    }

    .table-detail td {
        vertical-align: middle;
    }

    .table-detail .form-control, .table-detail .form-select {
        border-radius: 4px;
        padding: 0.375rem 0.5rem;
        font-size: 0.9rem;
    }
</style>

<div class="content-padding">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h4 class="mb-0">Lịch sử Nhập kho</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importTicketModal">
            <i class="fas fa-plus me-2"></i>Tạo phiếu nhập
        </button>
    </div>

    <div class="card p-3 border-0 shadow-sm mb-4">
        <form method="get" asp-action="Index" asp-controller="ImportTicket">
            <div class="row g-2">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Tìm mã phiếu (Ví dụ số ID)...">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter me-2"></i>Lọc</button>
                </div>
            </div>
        </form>
    </div>

    <div class="card p-0 border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th style="width: 25%;">Các mặt hàng</th>
                        <th class="text-end">Tổng SL</th>
                        <th>Người tạo</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Không có phiếu nhập nào.</td></tr>
                    }
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td class="fw-medium text-primary">PN-@ticket.NgayNhap.ToString("yyMMdd")-@ticket.MaPhieuNhap.ToString("D2")</td>
                            <td>@ticket.NgayNhap.ToString("dd/MM/yyyy")</td>
                            <td>@(ticket.MaNhaCungCapNavigation?.TenNhaCungCap ?? "N/A")</td>

                            <td>
                                @{
                                    // Lấy ra danh sách tên thực phẩm, loại bỏ các trường hợp null
                                    var danhSachTen = ticket.ChiTietPhieuNhaps
                                        .Where(c => c.MaLoNavigation != null && c.MaLoNavigation.MaThucPhamNavigation != null)
                                        .Select(c => c.MaLoNavigation.MaThucPhamNavigation.TenThucPham)
                                        .ToList();

                                    var chuoiMatHang = string.Join(", ", danhSachTen);
                                }
                                <span class="d-inline-block text-truncate" style="max-width: 250px;" title="@chuoiMatHang">
                                    @(string.IsNullOrEmpty(chuoiMatHang) ? "Chưa có mặt hàng" : chuoiMatHang)
                                    <small class="text-muted fw-bold">(x@(ticket.ChiTietPhieuNhaps.Count))</small>
                                </span>
                            </td>

                            <td class="text-end">@ticket.ChiTietPhieuNhaps.Sum(c => c.SoLuong)</td>
                            <td>@(ticket.NguoiTaoNavigation?.TenTaiKhoan ?? "Thủ kho")</td>
                            <td class="text-center"><span class="badge bg-success">Đã hoàn tất</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="importTicketModal" tabindex="-1" aria-labelledby="importTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="importTicketModalLabel">Tạo Phiếu Nhập Kho Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Create" asp-controller="ImportTicket" method="post" id="formImportTicket">
                <div class="modal-body p-4">
                    <h6 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-info-circle me-2"></i>Thông tin chung</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Mã phiếu</label>
                            <input type="text" class="form-control bg-light" value="PN-TỰ-ĐỘNG" readonly>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Ngày nhập <span class="text-danger">*</span></label>
                            <input type="date" name="NgayNhap" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Nhà cung cấp <span class="text-danger">*</span></label>
                            <select name="MaNhaCungCap" class="form-select" required>
                                <option value="" selected disabled>-- Chọn nhà cung cấp --</option>
                                @if (ViewBag.Suppliers != null)
                                {
                                    foreach (var ncc in ViewBag.Suppliers)
                                    {
                                        <option value="@ncc.MaNhaCungCap">@ncc.TenNhaCungCap</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Người Tạo <span class="text-danger">*</span></label>
                            <input type="text" name="NguoiTao" class="form-control" value="Khoa" readonly required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Ghi chú</label>
                            <input type="text" name="GhiChu" class="form-control" placeholder="Nhập ghi chú cho lô hàng này (nếu có)...">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h6 class="text-primary mb-0"><i class="fas fa-list-ul me-2"></i>Chi tiết thực phẩm nhập</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddRow"><i class="fas fa-plus me-1"></i> Thêm dòng</button>
                    </div>

                    <div class="table-responsive" style="min-height: 200px;">
                        <table class="table table-bordered table-detail" id="detailsTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 45%;">Tên thực phẩm</th>
                                    <th style="width: 20%;">Số lượng</th>
                                    <th style="width: 25%;">Hạn sử dụng</th>
                                    <th style="width: 10%;" class="text-center"><i class="fas fa-cog"></i></th>
                                </tr>
                            </thead>
                            <tbody id="detailsBody">
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success"><i class="fas fa-save me-2"></i>Xác nhận nhập kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const foodList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<FreshTrackWMS.Data.ThucPham>)ViewBag.Foods).Select(f => new
             {
                                          MaThucPham = f.MaThucPham,
                                TenThucPham = f.TenThucPham
                                    })
                ));
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const detailsBody = document.getElementById('detailsBody');
        const btnAddRow = document.getElementById('btnAddRow');

        function createRowHtml() {
            let optionsHtml = '<option value="" selected disabled>-- Chọn thực phẩm --</option>';
            foodList.forEach(f => {
                optionsHtml += `<option value="${f.MaThucPham}">TP${String(f.MaThucPham).padStart(3, '0')} - ${f.TenThucPham}</option>`;
            });

            const tr = document.createElement('tr');
            // Đã xóa cột ngày sản xuất (mfg-input) ở đây để khớp với HTML
            tr.innerHTML = `
                        <td>
                            <select class="form-select food-select" required>
                                ${optionsHtml}
                            </select>
                        </td>
                        <td><input type="number" class="form-control text-end qty-input" value="1" min="1" required></td>
                        <td><input type="date" class="form-control exp-input" required></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove"><i class="fas fa-trash"></i></button></td>
                    `;
            return tr;
        }

        function updateRowIndexes() {
            const rows = detailsBody.querySelectorAll('tr');
            rows.forEach((row, index) => {
                row.querySelector('.food-select').name = `Details[${index}].MaThucPham`;
                row.querySelector('.qty-input').name = `Details[${index}].SoLuong`;
                row.querySelector('.exp-input').name = `Details[${index}].HanSuDung`;
            });
        }

        btnAddRow.addEventListener('click', function () {
            detailsBody.appendChild(createRowHtml());
            updateRowIndexes();
        });

        detailsBody.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove')) {
                e.target.closest('tr').remove();
                updateRowIndexes();
            }
        });

        detailsBody.appendChild(createRowHtml());
        updateRowIndexes();

        document.getElementById('formImportTicket').addEventListener('submit', function (e) {
            if (detailsBody.querySelectorAll('tr').length === 0) {
                e.preventDefault();
                alert('Mày phải thêm ít nhất 1 mặt hàng để nhập kho!');
            }
        });
    });
</script>