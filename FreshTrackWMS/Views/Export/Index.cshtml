@model FreshTrackWMS.Models.ExportPageViewModel
@{
    ViewData["Title"] = "Quản lý Xuất kho";
    var availableBatches = ViewBag.AvailableBatches as List<FreshTrackWMS.Data.LoHang>;
}

<style>
    .table-detail th { font-size: 0.85rem; text-transform: uppercase; color: #555; }
    .table-detail td { vertical-align: middle; }
    .table-detail .form-control, .table-detail .form-select { border-radius: 4px; padding: 0.375rem 0.5rem; font-size: 0.9rem; }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="mb-0">Lịch sử Xuất kho</h4>
    <button class="btn btn-warning fw-medium" data-bs-toggle="modal" data-bs-target="#exportTicketModal">
        <i class="fas fa-truck-loading me-2"></i>Tạo phiếu xuất
    </button>
</div>

<form asp-action="Index" method="get" class="card p-3 border-0 shadow-sm mb-4">
    <div class="row g-2">
        <div class="col-md-10">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm mã phiếu xuất hoặc lý do xuất...">
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-filter me-2"></i>Tìm kiếm</button>
        </div>
    </div>
</form>

<div class="card p-0 border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Ngày xuất</th>
                    <th>Lý do xuất</th>
                    <th class="text-end">Số mặt hàng</th>
                    <th class="text-end">Tổng số lượng</th>
                    <th>Người tạo</th>
                    <th class="text-center">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tickets != null && Model.Tickets.Any())
                {
                    foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td class="fw-medium text-warning">PX-@ticket.MaPhieuXuat.ToString("D5")</td>
                            <td>@ticket.NgayXuat.ToString("dd/MM/yyyy")</td>
                            <td>@ticket.LyDoXuat</td>
                            <td class="text-end">@ticket.SoMatHang</td>
                            <td class="text-end fw-bold">@ticket.TongSoLuong Kg</td>
                            <td>@ticket.TenNguoiTao</td>
                            <td class="text-center"><span class="badge bg-success">Đã hoàn tất</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Chưa tìm thấy dữ liệu phiếu xuất kho phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3">
            <ul class="pagination pagination-sm justify-content-end mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">Trước</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">Tiếp</a>
                </li>
            </ul>
        </div>
    }
</div>

<div class="modal fade" id="exportTicketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning bg-opacity-25 border-warning border-bottom">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-truck-loading me-2"></i>Tạo Phiếu Xuất Kho Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <h6 class="text-dark border-bottom pb-2 mb-3 fw-bold"><i class="fas fa-info-circle me-2 text-warning"></i>Thông tin chung</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Người lập phiếu <span class="text-danger">*</span></label>
                            <input type="text" name="TenNguoiTao" class="form-control" value="thukho" required placeholder="Nhập tên tài khoản của bạn">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-medium">Ngày xuất kho <span class="text-danger">*</span></label>
                            <input type="date" name="NgayXuat" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Lý do xuất / Nơi nhận <span class="text-danger">*</span></label>
                            <input type="text" name="LyDoXuat" class="form-control" placeholder="Ví dụ: Xuất bán cho siêu thị Co.opmart Quận 1" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Ghi chú phiếu</label>
                            <input type="text" name="GhiChuTongQuan" class="form-control" placeholder="Nhập ghi chú tổng quan đợt xuất hàng (nếu có)...">
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h6 class="text-dark mb-0 fw-bold"><i class="fas fa-list-ul me-2 text-warning"></i>Chi tiết thực phẩm hàng hóa xuất</h6>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark" id="btn-add-row"><i class="fas fa-plus me-1"></i> Thêm thực phẩm</button>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-bordered table-detail" id="table-export-details">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 55%;">Chọn Thực phẩm & Lô hàng tồn (Gợi ý FEFO xếp trước)</th>
                                    <th style="width: 20%;">Tồn kho hiện tại</th>
                                    <th style="width: 20%;">Số lượng XUẤT</th>
                                    <th style="width: 5%;" class="text-center"><i class="fas fa-trash"></i></th>
                                </tr>
                            </thead>
                            <tbody id="export-tbody">
                                <tr class="export-row">
                                    <td>
                                        <select name="Details[0].MaLo" class="form-select select-batch border-warning" required onchange="onBatchChange(this)">
                                            <option value="">-- Chọn Thực phẩm - Mã Lô (Hạn sử dụng) --</option>
                                            @if (availableBatches != null)
                                            {
                                                foreach (var batch in availableBatches)
                                                {
                                                    string foodName = batch.MaThucPhamNavigation?.TenThucPham ?? "Chưa rõ tên";
                                                    string unit = batch.MaThucPhamNavigation?.DonViTinh ?? "Kg";
                                                    <option value="@batch.MaLo" data-max="@batch.SoLuong" data-unit="@unit">
                                                        @foodName - Lô #@batch.MaLo (HSD: @batch.HanSuDung.ToString("dd/MM/yyyy")) - Tồn: @batch.SoLuong @unit
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <input type="text" class="form-control bg-light text-end txt-stock-display" value="0" readonly>
                                            <span class="input-group-text bg-light text-muted txt-unit">Kg</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <input type="number" name="Details[0].SoLuongXuat" class="form-control border-primary text-end input-qty" value="1" min="1" required>
                                            <span class="input-group-text bg-white text-muted txt-unit">Kg</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="fas fa-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark"><i class="fas fa-check-circle me-2"></i>Xác nhận xuất kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onBatchChange(selectElement) {
            const tr = selectElement.closest('tr');
            const selectedOpt = selectElement.options[selectElement.selectedIndex];
            const qtyInput = tr.querySelector('.input-qty');
            const stockDisplay = tr.querySelector('.txt-stock-display');
            const unitSpans = tr.querySelectorAll('.txt-unit');

            if (selectedOpt && selectedOpt.value) {
                const maxStock = selectedOpt.getAttribute('data-max');
                const unitName = selectedOpt.getAttribute('data-unit');

                qtyInput.setAttribute('max', maxStock);
                stockDisplay.value = maxStock;
                
                unitSpans.forEach(span => span.innerText = unitName);
            } else {
                stockDisplay.value = 0;
                qtyInput.removeAttribute('max');
                unitSpans.forEach(span => span.innerText = 'Kg');
            }
        }

        function removeRow(button) {
            const rows = document.querySelectorAll('.export-row');
            if (rows.length > 1) {
                button.closest('tr').remove();
                reIndexRows();
            } else {
                alert('Phiếu xuất kho yêu cầu tối thiểu phải giữ lại 1 lô hàng.');
            }
        }

        function reIndexRows() {
            document.querySelectorAll('.export-row').forEach((row, index) => {
                row.querySelector('.select-batch').setAttribute('name', `Details[${index}].MaLo`);
                row.querySelector('.input-qty').setAttribute('name', `Details[${index}].SoLuongXuat`);
            });
        }

        document.getElementById('btn-add-row').addEventListener('click', function() {
            const tbody = document.getElementById('export-tbody');
            const firstRow = document.querySelector('.export-row');
            const cloneRow = firstRow.cloneNode(true);

            // Khởi tạo lại trạng thái trắng cho dòng mới thêm
            cloneRow.querySelector('.select-batch').value = '';
            cloneRow.querySelector('.input-qty').value = 1;
            cloneRow.querySelector('.txt-stock-display').value = 0;
            cloneRow.querySelectorAll('.txt-unit').forEach(span => span.innerText = 'Kg');

            tbody.appendChild(cloneRow);
            reIndexRows();
        });
    </script>
}