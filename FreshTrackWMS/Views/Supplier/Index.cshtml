@model FreshTrackWMS.Models.SupplierViewModel
@{
    ViewData["Title"] = "Quản lý Nhà cung cấp";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h4 class="mb-0">Danh sách Nhà cung cấp</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal" onclick="openCreateModal()">
        <i class="fas fa-plus me-2"></i>Thêm nhà cung cấp
    </button>
</div>

<div class="card p-3 border-0 shadow-sm mb-4">
    <form asp-action="Index" method="get">
        <div class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm theo tên, số điện thoại hoặc địa chỉ...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-search me-2"></i>Tìm</button>
            </div>
        </div>
    </form>
</div>

<div class="card p-0 border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã NCC</th>
                    <th>Tên nhà cung cấp</th>
                    <th>Liên hệ</th>
                    <th>Địa chỉ</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Suppliers.Any())
                {
                    foreach (var item in Model.Suppliers)
                    {
                        <tr>
                            <td class="fw-medium">NCC-@item.MaNhaCungCap</td>
                            <td class="fw-bold text-dark">@item.TenNhaCungCap</td>
                            <td>
                                <div><i class="fas fa-phone-alt text-muted me-2" style="width: 15px;"></i> @(item.SoDienThoai ?? "Chưa có")</div>
                                <div><i class="fas fa-envelope text-muted me-2" style="width: 15px;"></i> @(item.Email ?? "Chưa có")</div>
                            </td>
                            <td class="text-wrap" style="max-width: 250px;">@item.DiaChi</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-light text-primary me-1" title="Sửa" onclick="openEditModal(@item.MaNhaCungCap)"><i class="fas fa-edit"></i></button>
                                <form asp-action="Delete" asp-route-id="@item.MaNhaCungCap" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhà cung cấp này?');">
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Xóa"><i class="fas fa-trash-alt"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Không tìm thấy dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3">
            <ul class="pagination pagination-sm justify-content-end mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-searchTerm="@Model.SearchTerm" asp-route-page="@(Model.CurrentPage + 1)">Tiếp</a>
                </li>
            </ul>
        </div>
    }
</div>

<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-labelledby="addSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="supplierForm" asp-controller="Supplier" asp-action="Create" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="addSupplierModalLabel">Thêm mới Nhà cung cấp</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modal_MaNhaCungCap" asp-for="NewSupplier.MaNhaCungCap" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-medium">Tên nhà cung cấp <span class="text-danger">*</span></label>
                            <input type="text" id="modal_TenNhaCungCap" asp-for="NewSupplier.TenNhaCungCap" class="form-control" placeholder="Nhập tên công ty hoặc cá nhân" required>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" id="modal_SoDienThoai" asp-for="NewSupplier.SoDienThoai" class="form-control" placeholder="Nhập số điện thoại liên hệ" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Email</label>
                            <input type="email" id="modal_Email" asp-for="NewSupplier.Email" class="form-control" placeholder="Nhập địa chỉ email">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-medium">Địa chỉ <span class="text-danger">*</span></label>
                            <textarea id="modal_DiaChi" asp-for="NewSupplier.DiaChi" class="form-control" rows="3" placeholder="Nhập địa chỉ chi tiết" required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu thông tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Khi mở form Thêm mới: Clear trắng dữ liệu, đổi hành động form về Create
        function openCreateModal() {
            $('#addSupplierModalLabel').text('Thêm mới Nhà cung cấp');
            $('#supplierForm').attr('action', '/Supplier/Create');
            $('#modal_MaNhaCungCap').val(0);
            $('#modal_TenNhaCungCap').val('');
            $('#modal_SoDienThoai').val('');
            $('#modal_Email').val('');
            $('#modal_DiaChi').val('');
        }

        // Khi bấm Sửa: Gọi AJAX lấy dữ liệu thật từ DB lên đổ vào Form, đổi hành động về Edit
        function openEditModal(id) {
            $('#addSupplierModalLabel').text('Cập nhật thông tin Nhà cung cấp');
            $('#supplierForm').attr('action', '/Supplier/Edit');
            $.ajax({
                url: '/Supplier/GetSupplierJson/' + id,
                type: 'GET',
                success: function (data) {
                    $('#modal_MaNhaCungCap').val(data.maNcc);
                    $('#modal_TenNhaCungCap').val(data.tenNcc);
                    $('#modal_SoDienThoai').val(data.sdt);
                    $('#modal_Email').val(data.email);
                    $('#modal_DiaChi').val(data.diaChi);

                    // Mở hiển thị Modal lên màn hình
                    var myModal = new bootstrap.Modal(document.getElementById('addSupplierModal'));
                    myModal.show();
                },
                error: function () {
                    alert('Không thể lấy thông tin nhà cung cấp này!');
                }
            });
        }
    </script>
}
